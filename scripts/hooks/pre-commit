#!/usr/bin/env bash
# Pre-commit hook: fast, staged-file-only lint for immediate feedback.
# The full gate (brew style tap-wide, brew readall, brew audit,
# actionlint, shellcheck) runs at push time via scripts/hooks/pre-push;
# this hook only covers what is cheap enough to run on every commit.
#
# Activate once per clone:
#   git config core.hooksPath scripts/hooks
#
# Checks, scoped to staged files only (git diff --cached --name-only):
#   1. brew style — staged Formula/*.rb (RuboCop) and staged *.sh
#      (shfmt + shellcheck, per brew style's own machinery).
#   2. shellcheck --severity=warning — staged extensionless files under
#      scripts/hooks/ (brew style only recognizes *.sh by extension).
#   3. actionlint — staged .github/workflows/*.yml.
#
# Every check no-ops with a one-line notice when its tool isn't
# installed, so a missing linter never blocks a commit.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

mapfile -t STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACM)

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
  exit 0
fi

status=0

mapfile -t STAGED_STYLE < <(printf '%s\n' "${STAGED_FILES[@]}" | grep -E '^Formula/.*\.rb$|\.sh$' || true)
if [ ${#STAGED_STYLE[@]} -gt 0 ]; then
  if command -v brew >/dev/null 2>&1; then
    echo "==> brew style (staged formulas + shell scripts)"
    brew style "${STAGED_STYLE[@]}" || status=1
  else
    echo "pre-commit: brew not installed; skipping brew style"
  fi
fi

mapfile -t STAGED_HOOKS < <(printf '%s\n' "${STAGED_FILES[@]}" | grep -E '^scripts/hooks/[^.]+$' || true)
if [ ${#STAGED_HOOKS[@]} -gt 0 ]; then
  if command -v shellcheck >/dev/null 2>&1; then
    echo "==> shellcheck --severity=warning (staged extensionless hook files)"
    shellcheck --severity=warning --shell=bash "${STAGED_HOOKS[@]}" || status=1
  else
    echo "pre-commit: shellcheck not installed; skipping shell lint"
  fi
fi

mapfile -t STAGED_WORKFLOWS < <(printf '%s\n' "${STAGED_FILES[@]}" | grep -E '^\.github/workflows/.*\.ya?ml$' || true)
if [ ${#STAGED_WORKFLOWS[@]} -gt 0 ]; then
  if command -v actionlint >/dev/null 2>&1; then
    echo "==> actionlint (staged workflows)"
    actionlint "${STAGED_WORKFLOWS[@]}" || status=1
  else
    echo "pre-commit: actionlint not installed; skipping workflow lint"
  fi
fi

if [ $status -ne 0 ]; then
  echo "FAILED: pre-commit checks found issues in staged files." >&2
  exit 1
fi

echo "==> All pre-commit checks passed"
